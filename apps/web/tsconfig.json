{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client", "web-bluetooth", "w3c-web-serial", "vite-plugin-pwa/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@aero/protocol": ["../../packages/protocol/src/index.ts"],
      "@aero/motion-core": ["../../packages/motion-core/src/index.ts"],
      "@aero/activity-engine": ["../../packages/activity-engine/src/index.ts"],
      "@aero/music-engine": ["../../packages/music-engine/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
